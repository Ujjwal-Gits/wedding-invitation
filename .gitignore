# Dependencies and builds
node_modules/
server/node_modules/
dist/
.vite/
*.tsbuildinfo

# Secrets — never commit. Copy the matching .env.example instead.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
*.pem
*.key

# Private runtime data from the studio (guests' RSVPs, couples' uploads, sessions)
server/data/
server/uploads/
server/sessions/

# Local tools (Python venv for depth maps, model caches)
tools/.venv/
tools/
**/__pycache__/
*.pyc

# Original full-resolution art (hundreds of MB). The optimised copies the site uses
# live in public/photos; originals can be re-downloaded from the source_url in
# art-src/photos/credits.json.
art-src/photos/*.jpg
art-src/photos/*.jpeg
art-src/photos/*.png
art-src/depth/
art-src/music/
art-src/*.jpg
art-src/*.mp3
art-src/*.wav

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Local design-review tool state
.impeccable/

# Client reference screenshots (third-party designs, not ours to publish)
refs/

# Real client data and photos (private; never commit)
clients/

# Client photo archives dropped in the project root
*.zip

# Owner-supplied source images dropped in the project root (processed copies live in public/)
/ganesh image.webp

# Full-size phone stills (1170x2532) the site stills are made from (node src/site/make-thumbs.mjs)
art-src/stills/

# agent worktrees
.claude/worktrees/
