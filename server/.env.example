# Copy to .env and fill in. Never commit .env.

# The one admin who can sign in to the studio.
ADMIN_EMAIL=owner@example.com
# argon2id hash; create it with:  npm run hash-password
# Wrap it in single quotes so nothing in the hash is interpreted.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE_ME$REPLACE_ME'

PORT=8787
# "production" serves ../dist, sets Secure + __Host- cookies and HSTS.
NODE_ENV=development

# Public origin(s) of the site, comma separated. Used for share links and the RSVP Origin check.
# Same-origin requests (Origin host == Host header) are always allowed.
PUBLIC_ORIGIN=
# Set to 1 (or a hop count) when running behind a reverse proxy (nginx, Caddy, Render...).
TRUST_PROXY=0

# Background depth maps for uploaded photos (Depth Anything V2 Small). 1 = on.
DEPTH_ENABLED=1
# Python with torch + transformers + scipy + pillow. Default: ../tools/.venv/Scripts/python(.exe)
DEPTH_PYTHON=

# Optional (32+ characters): key for storing couples' links so the admin can copy them again.
# Unset: a random key is created once in data/link.key (keep data/ backed up; it is never committed).
LINK_SECRET=

# PayPal Checkout (optional; see docs/PAYMENTS.md). Online payment stays off until all four are set.
# sandbox = test money (developer.paypal.com sandbox app); live = real money. Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The ID PayPal shows for the webhook pointing at https://<your domain>/api/pay/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Storage and hardening (all optional; defaults and the full list: docs/OPERATIONS.md)
# STORE=sqlite            # or json: the old JSON files (rollback only; run npm run export-json first)
# CLOUDFLARE_ONLY=1       # production behind Cloudflare: refuse requests that bypassed it
# BACKUP_HOURS=24
# BACKUP_KEEP=14

# Email (Brevo): "Confirm your email" and "Forgot password". Off until both are set.
# BREVO_API_KEY: Brevo > SMTP & API > API keys. MAIL_FROM: a sender verified in Brevo > Senders & IP.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Nimtto
